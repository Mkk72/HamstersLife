{
  "name": "hamsters-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint eslint.config.js tools",
    "boundaries": "node tools/check-boundaries.mjs",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "balance:sim": "vitest run tools/balance-sim.test.ts --pool=threads",
    "verify": "pnpm typecheck && pnpm typecheck:tools && pnpm boundaries && pnpm lint && pnpm test && pnpm build",
    "dev:web": "pnpm --filter @hamsters/client dev",
    "preview:web": "pnpm --filter @hamsters/client preview"
  },
  "devDependencies": {
    "@hamsters/ai": "workspace:*",
    "@hamsters/content": "workspace:*",
    "@hamsters/core": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@hamsters/levelgen": "workspace:*"
  }
}
